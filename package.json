{
  "name": "chronoflow",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.8",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --go --lan",
    "start": "expo start --go --lan",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "docker:dev": "docker compose up --build dev",
    "docker:prod": "docker compose up --build web",
    "docker:build": "docker compose build",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint .",
    "doctor": "expo-doctor",
    "export": "expo export --platform android",
    "export:web": "expo export --platform web"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
