{
  "expo": {
    "name": "AST Time",
    "slug": "asttime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "chronoflow-alarms-v2",
          "enableRemoteNotifications": false
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.asteway.chronoflow",
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081321",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.asteway.chronoflow",
      "versionCode": 3,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0217f75e-a897-4345-8a63-8f6441904b7b"
      }
    },
    "owner": "asteway",
    "updates": {
      "url": "https://u.expo.dev/0217f75e-a897-4345-8a63-8f6441904b7b"
    }
  }
}
